# syntax=docker/dockerfile:1.7
FROM golang:1.25-bookworm AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends libpcap-dev ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY backend/go.mod ./backend/go.mod
COPY backend/go.sum* ./backend/
WORKDIR /src/backend
RUN --mount=type=cache,target=/go/pkg/mod go mod download || true

COPY backend /src/backend
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod tidy && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/pbr-server ./cmd/server

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends libpcap0.8 ca-certificates tini iproute2 curl \
  && rm -rf /var/lib/apt/lists/*

# Install nexttrace — the probe backend delegates all traceroute mechanics to it.
# Pinning to a specific release tag avoids surprise behavior changes.
ARG NEXTTRACE_VERSION=v1.6.4
ARG TARGETARCH=amd64
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) asset=nexttrace_linux_amd64 ;; \
      arm64) asset=nexttrace_linux_arm64 ;; \
      *) echo "unsupported arch ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/nxtrace/NTrace-core/releases/download/${NEXTTRACE_VERSION}/${asset}" -o /usr/local/bin/nexttrace; \
    chmod +x /usr/local/bin/nexttrace; \
    /usr/local/bin/nexttrace -V || true

WORKDIR /app
COPY --from=builder /out/pbr-server /usr/local/bin/pbr-server
COPY config /app/config

ENV HTTP_ADDR=:8080 \
    PROBE_MODE=mock

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/pbr-server"]
