# syntax=docker/dockerfile:1.7
FROM golang:1.25-bookworm AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends libpcap-dev ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY backend/go.mod ./backend/go.mod
COPY backend/go.sum* ./backend/
WORKDIR /src/backend
RUN --mount=type=cache,target=/go/pkg/mod go mod download || true

COPY backend /src/backend
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod tidy && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/pbr-server ./cmd/server

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends libpcap0.8 ca-certificates tini iproute2 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/pbr-server /usr/local/bin/pbr-server
COPY config /app/config

ENV HTTP_ADDR=:8080 \
    PROBE_MODE=mock

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/pbr-server"]
