# Backend
HTTP_ADDR=:8080
# PROBE_MODE: mock | icmp | tcp | udp
#   mock — synthetic hops, no network required (default)
#   icmp — real traceroute via nexttrace ICMP Echo (works on most networks)
#   tcp  — TCP SYN traceroute via nexttrace (needs target port open)
#   udp  — UDP traceroute via nexttrace (classic mode)
# The backend shells out to the `nexttrace` binary for icmp/tcp/udp; it's
# installed in the Docker image.
PROBE_MODE=mock
PROBE_INTERFACE=
WORKER_CONCURRENCY=32
MAX_TTL=40
# DOH_ENDPOINT should be a hostname URL (not an IP). The server uses SNI
# from the hostname to pick the right TLS cert. Put the actual IP(s) in
# DOH_BOOTSTRAP_IPS — the client dials those IPs but still sends the
# hostname as SNI and verifies the cert against the hostname.
DOH_ENDPOINT=https://dns.alidns.com/dns-query
# Alternatives:
#   AliDNS:     https://dns.alidns.com/dns-query        (bootstrap: 223.5.5.5,223.6.6.6)
#   Cloudflare: https://cloudflare-dns.com/dns-query    (bootstrap: 1.1.1.1,1.0.0.1)
#   Google:     https://dns.google/dns-query            (bootstrap: 8.8.8.8,8.8.4.4)
DOH_BOOTSTRAP_IPS=223.5.5.5,223.6.6.6
# Set to true only as a last resort if your DoH server's TLS cert can't be
# verified (e.g. self-signed or mismatched hostname). Prefer fixing the
# endpoint/bootstrap pairing first.
DOH_INSECURE=false
DATABASE_URL=
REDIS_URL=
MMDB_CITY_PATH=
MMDB_ASN_PATH=
RIPE_CACHE_TTL_HOURS=24

# Postgres (docker-compose)
POSTGRES_USER=pbr
POSTGRES_PASSWORD=pbr
POSTGRES_DB=pbr
