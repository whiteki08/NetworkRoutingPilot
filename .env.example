# Backend
HTTP_ADDR=:8080
PROBE_MODE=mock
PROBE_INTERFACE=
WORKER_CONCURRENCY=32
MAX_TTL=40
DOH_ENDPOINT=https://223.5.5.5/dns-query
# Alternatives:
#   Global:  https://cloudflare-dns.com/dns-query  (bootstrap: 1.1.1.1,1.0.0.1)
#   Google:  https://dns.google/dns-query           (bootstrap: 8.8.8.8,8.8.4.4)
DOH_BOOTSTRAP_IPS=223.5.5.5,223.6.6.6
# Set to true if your DoH server's TLS cert doesn't match its hostname
# (e.g. a private server with a wildcard cert on a different domain)
DOH_INSECURE=false
DATABASE_URL=
REDIS_URL=
MMDB_CITY_PATH=
MMDB_ASN_PATH=
RIPE_CACHE_TTL_HOURS=24

# Postgres (docker-compose)
POSTGRES_USER=pbr
POSTGRES_PASSWORD=pbr
POSTGRES_DB=pbr
